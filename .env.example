APP_NAME=SILAP-Kinerja
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
# APP_URL disesuaikan dengan subdomain HTTPS resmi dari tim IT (contoh: https://silap-kinerja.bmkg.go.id)
APP_URL=https://silap-kinerja.bmkg.go.id
SESSION_SECURE_COOKIE=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRACATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=silap_kinerja
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Google Workspace Shared Drive (Service Account dengan peran Content manager)
# Letakkan file JSON kredensial service account di storage/app/google-service-account.json
# atau tentukan path / JSON string di bawah ini
# Penyimpanan foto: local (development) atau drive (Shared Drive instansi).
# Dengan drive, foto disimpan sementara di server lalu diunggah oleh queue worker.
PHOTO_DISK=local
# Path relatif dihitung dari folder proyek
GOOGLE_SERVICE_ACCOUNT_PATH=storage/app/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SUPPORTS_ALL_DRIVES=true
